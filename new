apiVersion: apps/v1
kind: Deployment
metadata:
  name: apache-test
spec:
  replicas: 1
  selector:
    matchLabels:
      app: apache-test
  template:
    metadata:
      labels:
        app: apache-test
    spec:
      containers:
      - name: apache
        image: httpd:2.4
        ports:
        - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: apache-test
spec:
  selector:
    app: apache-test
  ports:
  - port: 80
    targetPort: 80
    nodePort: 30080
  type: NodePort
