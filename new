version: "3"

services:
    Router:
        image: handsonsecurity/seed-ubuntu:large
        platform: linux/amd64
        container_name: seed-router
        tty: true
        privileged: true
        cap_add:
            - ALL
        sysctls:
            - net.ipv4.ip_forward=1
        networks:
            net-10.9.0.0:
                ipv4_address: 10.9.0.11
            net-10.8.0.0:
                ipv4_address: 10.8.0.11
        command: bash -c "ip route del default || true && ip route add default via 10.8.0.1 || true && tail -f /dev/null"

    local-server:
        build: ./image_local_dns_server
        image: seed-local-dns-server
        platform: linux/amd64
        container_name: local-dns-server-10.9.0.53
        tty: true
        privileged: true
        cap_add:
            - ALL
        networks:
            net-10.9.0.0:
                ipv4_address: 10.9.0.53
        command: bash -c "ip route del default || true && ip route add default via 10.9.0.11 || true && /usr/sbin/named -u bind -c /etc/bind/named.conf && tail -f /dev/null"

    user:
        build: ./image_user
        image: seed-user
        platform: linux/amd64
        container_name: user-10.9.0.5
        tty: true
        cap_add:
            - ALL
        networks:
            net-10.9.0.0:
                ipv4_address: 10.9.0.5
        command: bash -c "ip route del default || true && ip route add default via 10.9.0.11 || true && /start.sh"

    attacker:
        image: handsonsecurity/seed-ubuntu:large
        platform: linux/amd64
        container_name: seed-attacker
        tty: true
        privileged: true
        cap_add:
            - ALL
        volumes:
            - ./volumes:/volumes
        network_mode: host

    attacker-ns:
        build: ./image_attacker_ns
        image: seed-attacker-ns
        platform: linux/amd64
        container_name: attacker-ns-10.9.0.153
        tty: true
        privileged: true
        cap_add:
            - ALL
        networks:
            net-10.9.0.0:
                ipv4_address: 10.9.0.153
        command: bash -c "/usr/sbin/named -u bind -c /etc/bind/named.conf && tail -f /dev/null"

networks:
    net-10.8.0.0:
        name: net-10.8.0.0
        ipam:
            config:
                - subnet: 10.8.0.0/24

    net-10.9.0.0:
        name: net-10.9.0.0
        ipam:
            config:
                - subnet: 10.9.0.0/24
