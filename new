Router:
  image: handsonsecurity/seed-ubuntu:large
  container_name: seed-router
  tty: true
  cap_add:
    - ALL
  sysctls:
    - net.ipv4.ip_forward=1
  volumes:
    - ./volumes:/volumes
  networks:
    net-10.9.0.0:
      ipv4_address: 10.9.0.11
    net-192.168.60.0:
      ipv4_address: 192.168.60.11
